# GitHub Personal Access Token (optional - for GitHub API integration)
# Create at: https://github.com/settings/tokens
# Scopes needed: public_repo (read only)
GITHUB_TOKEN=

# Contact Form (optional - connect to email provider)
# Example: Resend, SendGrid, Nodemailer
# RESEND_API_KEY=
# CONTACT_EMAIL=your@email.com

# Site URL (used for SEO / Open Graph)
NEXT_PUBLIC_SITE_URL=https://sokveng.com
